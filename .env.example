# ==============================================================================
# CATRS - Congestion-Aware Traffic Routing System Environment Configuration
# ==============================================================================

# Database & Cache Infrastructure
POSTGRES_DB=traffic
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
DATABASE_URL=postgresql://traffic:traffic@localhost:5432/traffic
REDIS_URL=redis://localhost:6379/0

# Service Ports (Host bindings)
ROUTING_ENGINE_PORT=8001
AUDIT_SERVICE_PORT=8002
FRONTEND_PORT=3000

# Operating Mode: 'synthetic' (default offline simulation) or 'production'
ROUTING_MODE=synthetic

# Traffic Dataset Mode: 'synthetic', 'metr_la', or 'pems_bay'
DATASET_MODE=synthetic
METR_LA_DATA_PATH=data/raw/METR-LA.csv
METR_LA_GRAPH_PATH=data/raw/adj_mx_METR-LA.pkl
PEMS_BAY_DATA_PATH=data/raw/PEMS-BAY.csv
PEMS_BAY_GRAPH_PATH=data/raw/adj_mx_PEMS-BAY.pkl

# External Production Data Feeds (Optional: left unset to use deterministic synthetic feeds)
# TRAFFIC_FEED_URL=http://traffic-provider.local/api/v1
# WEATHER_FEED_URL=http://weather-provider.local/api/v1
# INCIDENT_FEED_URL=http://incident-provider.local/api/v1
# EVENT_FEED_URL=http://event-provider.local/api/v1

# Spatio-Temporal GNN (ST-GNN) Settings
STGNN_ENABLED=false
STGNN_CHECKPOINT_PATH=checkpoints/stgnn_default.pt
STGNN_FEATURE_COUNT=9
STGNN_NODE_COUNT=100
STGNN_HIDDEN_SIZE=32

# Prediction Horizon Configuration
PREDICTION_WINDOW_STEPS=12
PREDICTION_INTERVAL_MINUTES=5

# Priority Routing & Equilibrium Diversification Defaults
DEFAULT_CAP_FRACTION=1.0
DIVERSIFICATION_WINDOW_SECONDS=60
