POSTGRES_DB=traffic
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
DATABASE_URL=postgresql://traffic:traffic@localhost:5432/traffic
REDIS_URL=redis://localhost:6379/0
ROUTING_ENGINE_PORT=8001
AUDIT_SERVICE_PORT=8002

# Operating mode: synthetic (default) or production
ROUTING_MODE=synthetic
AUDIT_MODE=synthetic

# Production feed URLs (leave unset to use synthetic data)
# TRAFFIC_FEED_URL=http://traffic-provider:8080
# WEATHER_FEED_URL=http://weather-provider:8080
# INCIDENT_FEED_URL=http://incident-provider:8080
# EVENT_FEED_URL=http://event-provider:8080

# ST-GNN model settings (disabled by default)
STGNN_ENABLED=false
# STGNN_CHECKPOINT_PATH=/path/to/model.pt
STGNN_FEATURE_COUNT=9
STGNN_NODE_COUNT=100
STGNN_HIDDEN_SIZE=32
